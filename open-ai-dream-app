#!/usr/bin/env bash
set -u

ROOT=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd) || exit 1
cd "$ROOT" || exit 1

PORT=8765
URL=""
LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/ai-dream"
LOG_FILE="$LOG_DIR/web.log"
APP_PROFILE="${XDG_DATA_HOME:-$HOME/.local/share}/ai-dream/chrome-profile"
SERVER_PID=""

show_error() {
  if command -v zenity >/dev/null 2>&1; then
    zenity --error --title="AI Dream" --text="$1" 2>/dev/null || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send "AI Dream" "$1" 2>/dev/null || true
  fi
}

web_ready() {
  python3 - "$1" <<'PY' >/dev/null 2>&1
import sys
import urllib.request

try:
    with urllib.request.urlopen(f"http://127.0.0.1:{sys.argv[1]}/chat", timeout=0.6) as response:
        valid = response.status == 200 and response.headers.get_content_type() == "text/html"
        valid = valid and b"<ai-root>" in response.read(65536)
    raise SystemExit(0 if valid else 1)
except Exception:
    raise SystemExit(1)
PY
}

port_available() {
  python3 - "$1" <<'PY' >/dev/null 2>&1
import socket
import sys

try:
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", int(sys.argv[1])))
except OSError:
    raise SystemExit(1)
PY
}

free_port() {
  python3 - <<'PY'
import socket

with socket.socket() as sock:
    sock.bind(("127.0.0.1", 0))
    print(sock.getsockname()[1])
PY
}

if web_ready "$PORT"; then
  URL="http://127.0.0.1:$PORT"
else
  if ! port_available "$PORT"; then
    PORT=$(free_port) || exit 1
  fi
  mkdir -p "$APP_PROFILE" 2>/dev/null || true
  if ! mkdir -p "$LOG_DIR" 2>/dev/null || ! { : >>"$LOG_FILE"; } 2>/dev/null; then
    LOG_FILE=/dev/null
  fi
  python3 -u -m aidream web --port "$PORT" --no-open >>"$LOG_FILE" 2>&1 </dev/null &
  SERVER_PID=$!
  for _ in {1..50}; do
    if web_ready "$PORT"; then break; fi
    sleep 0.2
  done
  if ! web_ready "$PORT"; then
    if [[ -n "$SERVER_PID" ]]; then kill "$SERVER_PID" 2>/dev/null || true; wait "$SERVER_PID" 2>/dev/null || true; fi
    show_error "AI Dream could not serve its application page on port $PORT. See $LOG_FILE for details."
    exit 1
  fi
  URL="http://127.0.0.1:$PORT"
fi

CHROME=$(command -v google-chrome || command -v google-chrome-stable || true)
if [[ -z "$CHROME" ]]; then
  if [[ -n "$SERVER_PID" ]]; then kill "$SERVER_PID" 2>/dev/null || true; wait "$SERVER_PID" 2>/dev/null || true; fi
  show_error "Google Chrome is required for the AI Dream application window."
  exit 1
fi

mkdir -p "$APP_PROFILE" 2>/dev/null || true
"$CHROME" --user-data-dir="$APP_PROFILE" --no-first-run --no-default-browser-check --app="$URL/chat" --class=AiDream --new-window
status=$?
if [[ -n "$SERVER_PID" ]]; then
  kill "$SERVER_PID" 2>/dev/null || true
  wait "$SERVER_PID" 2>/dev/null || true
fi
exit "$status"
