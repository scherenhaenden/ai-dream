#!/usr/bin/env bash
set -u
cd -- "$(dirname -- "$(readlink -f -- "$0")")" || {
  echo "AI Dream Web: could not enter the application directory." >&2
  exit 1
}

python3 -m aidream web "$@"
status=$?
if (( status != 0 )); then
  echo "AI Dream Web startup failed (exit $status). Check that web/dist exists and review the error above." >&2
fi
exit "$status"
