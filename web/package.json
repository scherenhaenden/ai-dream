{
  "name": "ai-dream-angular-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:runtime-layout": "node scripts/check-runtime-layout.mjs",
    "test:nav-routes": "node scripts/check-nav-routes.mjs",
    "test:templates": "node scripts/check-templates.mjs",
    "test:model-studio-ui": "node scripts/check-model-studio-ui.mjs",
    "test:chat-agent-ui": "node scripts/check-chat-agent-ui.mjs",
    "test:chat-orchestration-ui": "node scripts/check-chat-orchestration-ui.mjs",
    "test:run-citation-document-ui": "node scripts/check-run-citation-document-ui.mjs",
    "test:assisted-planner-ux": "node scripts/check-assisted-planner-ux.mjs",
    "test:model-capability-profile-context": "node scripts/check-model-capability-profile-context.mjs",
    "test:skill-permissions-ux": "node scripts/check-skill-permissions-ux.mjs",
    "test:ui-smoke": "node scripts/smoke-hardware-settings-ui.mjs",
    "test:hardware-settings-ui": "node scripts/smoke-hardware-settings-ui.mjs",
    "test:models-config": "node scripts/check-models-config.mjs",
    "test:artifact-run-ux": "node scripts/check-artifact-session-ux.mjs && node scripts/check-run-citation-document-ui.mjs"
  },
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.2.0",
    "@angular/build": "^20.3.37",
    "@angular/compiler-cli": "^20.3.32",
    "@playwright/test": "^1.50.1",
    "finalhandler": "^1.3.1",
    "serve-static": "^1.16.2",
    "typescript": "~5.9.2",
    "vite": "^6.3.0"
  }
}
