#!/usr/bin/env bash
set -u
cd -- "$(dirname -- "$(readlink -f -- "$0")")" || {
  echo "AI Dream: could not enter the application directory." >&2
  exit 1
}

python3 -m aidream.ui
status=$?
if (( status != 0 )); then
  echo "AI Dream desktop startup failed (exit $status). Check the Python/Tk installation and the error above." >&2
fi
exit "$status"
